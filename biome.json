{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"experimentalScannerIgnores": ["node_modules", ".nuxt", ".output", "dist", ".git", "*.min.js"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "off"
      },
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "warn",
				"useTemplate": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"overrides": [
		{
			"includes": ["*.vue"],
			"formatter": {
				"enabled": true
			},
			"linter": {
				"enabled": true
			},
			"javascript": {
				"formatter": {
					"quoteStyle": "double",
					"semicolons": "always"
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
